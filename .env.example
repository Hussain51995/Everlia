# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never expose to the browser.
# Required for organization creation (platform admin APIs) and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seeded platform admin (used by `npm run seed:platform-admin`).
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public app URL used for auth email redirects (password recovery + email verify).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true  = send emails via Resend
# false = show verification/reset links in the UI for local testing
EMAIL_VERIFICATION=true

# Resend (https://resend.com) — required when EMAIL_VERIFICATION=true
RESEND_API_KEY=re_xxxxxxx
EMAIL_FROM=HomeLink <onboarding@your-verified-domain.com>

# Optional: override / extend personal email domains blocked from org auto-match
# PERSONAL_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,icloud.com
# PERSONAL_EMAIL_DOMAINS_EXTRA=custom-mail.test

# Mail provider abstraction (MVP: PostGrid)
# Active provider can also be selected in DB (mail_provider_configs).
MAIL_PROVIDER=postgrid
POSTGRID_API_KEY=test_xxxxxxxx
POSTGRID_MODE=test
# Must match the webhook secret from PostGrid (Dashboard → Webhooks).
# Used to verify PostGrid-Signature (JSON) or decode JWT payloads.
POSTGRID_WEBHOOK_SECRET=

# Campaign mailing worker (Vercel Cron → POST /api/cron/campaign-mailings)
# Vercel injects this as Authorization: Bearer <CRON_SECRET> for cron jobs.
CRON_SECRET=replace-with-a-long-random-string

# Live campaign mailing is DISABLED by default.
# Requires BOTH flags + a live PostGrid API key (not test_sk_…).
# CAMPAIGN_LIVE_MAIL_ENABLED=true
# POSTGRID_MODE=live
# POSTGRID_API_KEY=live_xxxxxxxx

# Campaign pricing . Default free/waived — does not charge users.
CAMPAIGN_PRICING_MODE=free
# CAMPAIGN_PRICING_MODE=paid_stub
# CAMPAIGN_UNIT_POSTAGE_CENTS=0
# CAMPAIGN_UNIT_PLATFORM_CENTS=0
# CAMPAIGN_PRICING_CURRENCY=USD

# OpenAI (Messages tab AI chat). Server-only — never expose to the browser.
# Required for POST /api/organization/occasion-messages/ai
OPENAI_API_KEY=

# RentCast (server-only). Used by:
# - Admin API Tester (PoC)
# - Property Intelligence RentCast adapter (when production insights are enabled later)
# NEVER use NEXT_PUBLIC_. NEVER hardcode. NEVER log.
# Obtain your key from https://app.rentcast.io → API Keys.
RENTCAST_API_KEY=your_rentcast_api_key_here

# Shared RentCast account budget (UTC calendar month, request units).
# Used by BOTH the admin RentCast tester and Property Intelligence production
# reservations so the tester cannot bypass the production provider limit.
# One address submission may cost multiple units (capability.requestCostUnits).
# This is an application guard only — it does not include usage made outside
# Everlia. Verify the real RentCast account allowance before live enablement.
# Defaults to 50 if unset (free-plan testing default).
PROPERTY_INTELLIGENCE_MONTHLY_BUDGET=50
# Legacy alias (still honored when PROPERTY_INTELLIGENCE_MONTHLY_BUDGET is unset):
RENTCAST_TEST_MONTHLY_BUDGET=50
# Optional provider account scope for multi-key setups (default: "default")
# PROPERTY_INTELLIGENCE_API_ACCOUNT_SCOPE=default

# ---------------------------------------------------------------------------
# Upstash Redis — Property Intelligence V2 L2 payload cache (server-only)
# ---------------------------------------------------------------------------
# Create a Redis database at https://console.upstash.com → REST API credentials.
# Compatible with Next.js / Vercel serverless (HTTP REST client @upstash/redis).
# NEVER use NEXT_PUBLIC_. NEVER commit real tokens. NEVER expose to the browser.
# Property Intelligence server cache (L2) — Upstash Redis REST only.
# Browser cache (L1) is client-side; Supabase is not a property payload store.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
# Optional override for Redis key namespacing (development | preview | production | test).
# Defaults from VERCEL_ENV / NODE_ENV when unset.
# PROPERTY_INTELLIGENCE_CACHE_ENV=development
