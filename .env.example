# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never expose to the browser.
# Required for organization creation (platform admin APIs) and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seeded platform admin (used by `npm run seed:platform-admin`).
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public app URL used for auth email redirects (password recovery + email verify).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true  = send emails via Resend
# false = show verification/reset links in the UI for local testing
EMAIL_VERIFICATION=true

# Resend (https://resend.com) — required when EMAIL_VERIFICATION=true
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=HomeLink <onboarding@your-verified-domain.com>
